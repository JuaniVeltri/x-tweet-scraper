{
  /* Type-checks the test suite without emitting. `tsconfig.json` deliberately
     excludes `tests/` so that the build output stays flat under `dist/`. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
