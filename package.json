{
  "name": "x-tweet-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browserless X (Twitter) scraper Apify Actor. Fetches public tweets over X's internal GraphQL API using guest tokens only, with a server-authoritative free-tier cap.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "tsx src/main.ts",
    "start:prod": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "apify": "^3.7.2",
    "got-scraping": "^4.2.1",
    "p-limit": "^7.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
